# ═══════════════════════════════════════════════════════════════
# Derek On Capital — Apache config for IONOS shared hosting,
# fronted by Cloudflare (Flexible SSL).
#
# HTTP→HTTPS is handled at Cloudflare's edge (SSL/TLS → Edge
# Certificates → "Always Use HTTPS" = ON). We do NOT redirect at
# the origin: Cloudflare in Flexible mode forwards plain HTTP to
# IONOS even when the visitor is on HTTPS, so an origin-side
# redirect would loop forever. We still collapse www → apex here
# as a safety net if a request bypasses Cloudflare's redirect
# rule (and so the origin can be tested directly).
# ═══════════════════════════════════════════════════════════════

# ── Canonical host: drop the www ───────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  # Tell browsers to always use HTTPS for the next year. Browsers
  # ignore this header when received over plain HTTP, so it only
  # takes effect once the SSL cert is live. Add "; preload" later
  # if you submit the domain to hstspreload.org.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Optional Content-Security-Policy. Left commented because a CSP
  # is easy to get wrong and will silently break Google Fonts,
  # Calendly, or an analytics snippet. Tighten and enable when ready.
  # Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'"
</IfModule>

# ── Compression ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ── Caching ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML revalidates every load so content edits show up immediately.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresDefault "access plus 2 days"
</IfModule>

# ── Hardening ──────────────────────────────────────────────────
# No directory listings (e.g. visiting /blog/ never shows a file list).
Options -Indexes

# Default document.
DirectoryIndex index.html
